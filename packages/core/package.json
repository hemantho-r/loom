{
  "name": "@loom-skills/core",
  "version": "0.1.0",
  "description": "Core runtime for Loom skill system",
  "homepage": "https://github.com/hemantho-r/loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/hemantho-r/loom.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/hemantho-r/loom/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
