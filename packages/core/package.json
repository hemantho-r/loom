{
  "name": "@loom/core",
  "version": "0.1.0",
  "description": "Core runtime for Loom skill system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
