{
  "name": "@loom/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Loom skill system",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loom": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/schema": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
