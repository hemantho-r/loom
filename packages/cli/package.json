{
  "name": "@loom-skills/loom",
  "version": "0.1.1",
  "description": "Installs the Loom skill library into ~/.loom/skills on npm install",
  "homepage": "https://github.com/hemantho-r/loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/hemantho-r/loom.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hemantho-r/loom/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist/skills && cp -R ../../skills/. dist/skills/",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.mjs"
  }
}
