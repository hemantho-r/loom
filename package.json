{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "description": "Skills woven together — A skill operating system for AI coding agents",
  "license": "MIT",
  "homepage": "https://github.com/hemantho-r/loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/hemantho-r/loom.git"
  },
  "bugs": {
    "url": "https://github.com/hemantho-r/loom/issues"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @loom-skills/core build && pnpm --filter @loom-skills/schema build && pnpm --filter @loom-skills/loom build",
    "dev": "pnpm --filter @loom-skills/core dev & pnpm --filter @loom-skills/loom dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "validate": "node scripts/validate-skills.mjs",
    "eval": "node --experimental-strip-types evals/eval-runner.ts",
    "eval:grade": "node scripts/grade-eval.mjs",
    "check": "node scripts/check-consistency.mjs",
    "generate:adapters": "node scripts/generate-adapters.mjs",
    "release:dry-run": "pnpm build && pnpm -r publish --access public --dry-run",
    "release": "pnpm build && pnpm -r publish --access public"
  },
  "dependencies": {
    "@loom-skills/core": "workspace:*",
    "chalk": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
